# Единственный обязательный секрет — токен бота из @BotFather.
TELEGRAM_BOT_TOKEN=123456:ABC...
# Upstash Redis: Vercel → Storage → Upstash for Redis создаёт эти переменные сам.
KV_REST_API_URL=https://xxx.upstash.io
KV_REST_API_TOKEN=xxx
# Необязательно: имя бота (иначе берётся через getMe) и адрес сайта (иначе из запроса).
# TELEGRAM_BOT_USERNAME=
# SITE_URL=
